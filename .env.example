# Copy this file to .env and fill in real values before running the app.

# Port the server listens on
PORT=3000

# Long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-string

# Path to the SQLite database file
DB_PATH=./data/tickets.sqlite

# Set to "true" once the app is served over HTTPS (production) so session
# cookies are marked Secure. Keep "false" for local http:// development.
COOKIE_SECURE=false

# Optional: email notifications to requesters (ticket received, status
# changes). Leave SMTP_HOST blank to keep email notifications off entirely -
# the app works fine without any of this set.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Velv Ticketing <no-reply@example.com>"

# Optional: public URL of this app (no trailing slash), used to build a
# clickable status-check link in notification emails. Without it, emails just
# name the status page instead of linking to it.
APP_URL=

# Optional: where `npm run backup` writes timestamped snapshots, and how many
# to keep before pruning the oldest. Defaults to data/backups/ and 14.
BACKUP_DIR=
BACKUP_KEEP=14

# Optional: how often (in minutes) the server checks for tickets that have
# crossed their aging threshold and emails whoever they're assigned to.
# Defaults to 15. Only matters if SMTP_HOST is set above.
SLA_CHECK_INTERVAL_MINUTES=15

# Optional: how many days before an asset's warranty expiry to start
# emailing the whole active team a heads-up. Defaults to 30. Checked on the
# same interval as SLA_CHECK_INTERVAL_MINUTES above.
WARRANTY_ALERT_DAYS=30

# Optional: which local hour (0-23, server's own timezone) to send each
# agent's daily digest email at. Defaults to 8 (8am). Only matters if
# SMTP_HOST is set above - only fires on whichever periodic check
# (SLA_CHECK_INTERVAL_MINUTES) happens to land in that hour, and at most
# once per agent per calendar day either way.
DIGEST_HOUR=8
