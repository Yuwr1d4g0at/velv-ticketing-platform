# Copy this file to .env and fill in real values before running the app.

# Port the server listens on
PORT=3000

# Long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-string

# Path to the SQLite database file
DB_PATH=./data/tickets.sqlite

# Set to "true" once the app is served over HTTPS (production) so session
# cookies are marked Secure. Keep "false" for local http:// development.
COOKIE_SECURE=false
