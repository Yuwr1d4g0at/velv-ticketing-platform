<%- include('../partials/header') %>
<div class="auth-split">
  <div class="auth-split-brand">
    <img src="/img/velv-logo-white.png" alt="Velv">
    <h2>Our Team.<br>Remotely Yours.</h2>
    <p>Sign in to manage requests, assets, and your team's queue.</p>
  </div>
  <div class="auth-split-form">
    <span class="card-icon"><span class="icon icon-lock"></span></span>
    <h1>Two-factor code</h1>
    <p class="muted">Enter the 6-digit code from your authenticator app.</p>
    <% if (error) { %>
      <div class="alert alert-error" role="alert"><span class="icon icon-alert-triangle"></span><%= error %></div>
    <% } %>
    <form action="/login/2fa" method="POST" class="stacked-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label for="code">6-digit code</label>
      <input type="text" id="code" name="code" inputmode="numeric" pattern="[0-9]*" autocomplete="one-time-code" maxlength="6" required autofocus>

      <button type="submit" class="button-primary">Verify</button>
    </form>
    <p><a href="/login">Cancel and start over</a></p>
  </div>
</div>
<%- include('../partials/footer') %>
