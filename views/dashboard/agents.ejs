<%- include('../partials/header') %>
<h1>Agents</h1>

<div class="table-wrap">
  <table class="ticket-table">
    <thead>
      <tr>
        <th scope="col">Name</th>
        <th scope="col">Email</th>
        <th scope="col">Open tickets assigned</th>
        <th scope="col">Added</th>
        <th scope="col">Status</th>
        <th scope="col"></th>
      </tr>
    </thead>
    <tbody>
      <% agents.forEach(function(a) { %>
        <tr class="<%= a.active ? '' : 'row-inactive' %>">
          <td>
            <div class="requester-line">
              <% if (a.profile) { %>
                <img class="directory-avatar" src="/dashboard/directory/photo?email=<%= encodeURIComponent(a.email) %>" alt="">
              <% } %>
              <div>
                <%= a.name %>
                <% if (a.profile && (a.profile.jobTitle || a.profile.department || a.profile.phone)) { %>
                  <br><span class="muted"><%= [a.profile.jobTitle, a.profile.department].filter(Boolean).join(' · ') %><% if (a.profile.phone) { %><%= (a.profile.jobTitle || a.profile.department) ? ' · ' : '' %><%= a.profile.phone %><% } %></span>
                <% } %>
              </div>
            </div>
          </td>
          <td><%= a.email %></td>
          <td><%= a.open_count %></td>
          <td><%= a.created_at %></td>
          <td><span class="badge <%= a.active ? 'badge-status-open' : '' %>"><%= a.active ? 'Active' : 'Deactivated' %></span></td>
          <td>
            <% if (a.active) { %>
              <form action="/dashboard/agents/<%= a.id %>/deactivate" method="POST" class="inline-form">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="link-button">Deactivate</button>
              </form>
            <% } else { %>
              <form action="/dashboard/agents/<%= a.id %>/activate" method="POST" class="inline-form">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="link-button">Reactivate</button>
              </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<div class="card card-narrow">
  <h2>Add an agent</h2>
  <% if (error) { %>
    <div class="alert alert-error" role="alert"><span class="icon icon-alert-triangle"></span><%= error %></div>
  <% } %>
  <form action="/dashboard/agents" method="POST" class="stacked-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label for="name">Name</label>
    <input type="text" id="name" name="name" required maxlength="200">

    <label for="email">Email</label>
    <input type="email" id="email" name="email" required maxlength="200">

    <label for="password">Temporary password (min 8 characters)</label>
    <input type="password" id="password" name="password" required minlength="8">

    <button type="submit" class="button-primary">Add agent</button>
  </form>
</div>
<%- include('../partials/footer') %>
