<%- include('../partials/header') %>
<h1>Agents</h1>

<div class="table-wrap">
  <table class="ticket-table">
    <thead>
      <tr>
        <th scope="col">Name</th>
        <th scope="col">Email</th>
        <th scope="col">Department</th>
        <th scope="col">Admin</th>
        <th scope="col">Open tickets assigned</th>
        <th scope="col">Added</th>
        <th scope="col">Status</th>
        <th scope="col">2FA</th>
        <th scope="col"></th>
      </tr>
    </thead>
    <tbody>
      <% agents.forEach(function(a) { %>
        <tr class="<%= a.active ? '' : 'row-inactive' %>">
          <td>
            <div class="requester-line">
              <% if (a.profile) { %>
                <img class="directory-avatar" src="/dashboard/directory/photo?email=<%= encodeURIComponent(a.email) %>" alt="">
              <% } %>
              <div>
                <%= a.name %>
                <% if (a.profile && (a.profile.jobTitle || a.profile.department || a.profile.phone)) { %>
                  <br><span class="muted"><%= [a.profile.jobTitle, a.profile.department].filter(Boolean).join(' · ') %><% if (a.profile.phone) { %><%= (a.profile.jobTitle || a.profile.department) ? ' · ' : '' %><%= a.profile.phone %><% } %></span>
                <% } %>
              </div>
            </div>
          </td>
          <td><%= a.email %></td>
          <td>
            <form action="/dashboard/agents/<%= a.id %>/department" method="POST" class="inline-form">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <select name="department_id" aria-label="Department for <%= a.name %>" data-autosubmit>
                <% departmentsList.forEach(function(d) { %>
                  <option value="<%= d.id %>" <%= a.department_id === d.id ? 'selected' : '' %>><%= d.name %></option>
                <% }) %>
              </select>
            </form>
          </td>
          <td>
            <form action="/dashboard/agents/<%= a.id %>/admin" method="POST" class="inline-form">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <label class="checkbox-label">
                <input type="checkbox" name="is_admin" value="1" <%= a.is_admin ? 'checked' : '' %> data-autosubmit aria-label="Admin (sees every department) for <%= a.name %>">
                Admin
              </label>
            </form>
          </td>
          <td><%= a.open_count %></td>
          <td><%= a.created_at %></td>
          <td><span class="badge <%= a.active ? 'badge-status-open' : '' %>"><%= a.active ? 'Active' : 'Deactivated' %></span></td>
          <td>
            <% if (a.totp_enabled) { %>
              <span class="badge badge-status-resolved">On</span>
              <form action="/dashboard/agents/<%= a.id %>/reset-2fa" method="POST" class="inline-form" data-confirm="Reset two-factor authentication for <%= a.name %>? They'll be able to log in with just their password until they set it up again.">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="link-button">Reset (lost device)</button>
              </form>
            <% } else { %>
              <span class="badge">Off</span>
            <% } %>
          </td>
          <td>
            <% if (a.active) { %>
              <form action="/dashboard/agents/<%= a.id %>/deactivate" method="POST" class="inline-form">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="link-button">Deactivate</button>
              </form>
            <% } else { %>
              <form action="/dashboard/agents/<%= a.id %>/activate" method="POST" class="inline-form">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="link-button">Reactivate</button>
              </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<div class="card card-narrow">
  <h2>Add an agent</h2>
  <p class="muted">Admin bypasses department scoping everywhere - the only sanctioned way to see and act across every department. Grant it deliberately.</p>
  <% if (error) { %>
    <div class="alert alert-error" role="alert"><span class="icon icon-alert-triangle"></span><%= error %></div>
  <% } %>
  <form action="/dashboard/agents" method="POST" class="stacked-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label for="name">Name</label>
    <input type="text" id="name" name="name" required maxlength="200">

    <label for="email">Email</label>
    <input type="email" id="email" name="email" required maxlength="200">

    <label for="password">Temporary password (min 8 characters)</label>
    <input type="password" id="password" name="password" required minlength="8">

    <label for="department_id">Department</label>
    <select id="department_id" name="department_id" required>
      <option value="" disabled selected>Choose one&hellip;</option>
      <% departmentsList.forEach(function(d) { %><option value="<%= d.id %>"><%= d.name %></option><% }) %>
    </select>

    <label class="checkbox-label">
      <input type="checkbox" name="is_admin" value="1">
      Admin (sees and acts across every department)
    </label>

    <button type="submit" class="button-primary">Add agent</button>
  </form>
</div>
<%- include('../partials/footer') %>
