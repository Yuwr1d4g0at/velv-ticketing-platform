<%- include('../partials/header') %>
<div class="ticket-head">
  <div>
    <h1>#<%= ticket.id %> &middot; <%= ticket.subject %></h1>
    <p class="muted">
      From <%= ticket.requester_name %> (<%= ticket.requester_email %>) &middot; opened <%= ticket.created_at %>
    </p>
  </div>
  <div class="badge-group">
    <% if (aging) { %><span class="badge badge-aging">Aging</span><% } %>
    <span class="badge badge-priority-<%= ticket.priority.toLowerCase() %>"><%= ticket.priority %></span>
    <span class="badge badge-status-<%= ticket.status.replace(/\s+/g, '-').toLowerCase() %>"><%= ticket.status %></span>
  </div>
</div>

<div class="tag-row">
  <% tags.forEach(function(t) { %>
    <span class="tag-chip">
      <%= t.name %>
      <form action="/dashboard/tickets/<%= ticket.id %>/tags/<%= t.id %>/remove" method="POST" class="inline-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" aria-label="Remove tag <%= t.name %>">&times;</button>
      </form>
    </span>
  <% }) %>
  <form action="/dashboard/tickets/<%= ticket.id %>/tags" method="POST" class="tag-add-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="text" name="tag" placeholder="Add a tag&hellip;" maxlength="30" list="existing-tags">
    <datalist id="existing-tags">
      <% allTags.forEach(function(t) { %><option value="<%= t.name %>"><% }) %>
    </datalist>
    <button type="submit" class="button-secondary">Add tag</button>
  </form>
</div>

<div class="ticket-grid">
  <div class="ticket-main">
    <div class="card">
      <h2>Description</h2>
      <p class="preserve-newlines"><%= ticket.description %></p>
      <p class="muted">Category: <%= ticket.category %></p>

      <% if (rating) { %>
        <h2>Satisfaction rating</h2>
        <p class="rating-stars" aria-label="<%= rating.rating %> out of 5 stars">
          <% for (let i = 1; i <= 5; i++) { %><span class="icon icon-star <%= i <= rating.rating ? 'is-filled' : '' %>"></span><% } %>
        </p>
        <% if (rating.comment) { %><p class="preserve-newlines"><%= rating.comment %></p><% } %>
      <% } %>

      <% if (attachments.length) { %>
        <h2>Attachments</h2>
        <ul class="attachment-list">
          <% attachments.forEach(function(a) { %>
            <li class="attachment-item">
              <span class="attachment-name"><%= a.original_name %></span>
              <span class="attachment-meta">
                <%= a.uploaded_by === 'agent' ? a.agent_name : ticket.requester_name %> &middot; <%= a.size_label %>
              </span>
              <a class="attachment-download-btn" href="/dashboard/tickets/<%= ticket.id %>/attachments/<%= a.id %>/download">
                <span class="icon icon-download"></span>Download
              </a>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </div>

    <div class="card">
      <h2>Activity</h2>
      <ul class="activity-feed">
        <% if (!activity.length) { %>
          <li class="muted">No activity yet.</li>
        <% } %>
        <% activity.forEach(function(a) { %>
          <li class="activity-item activity-<%= a.type %>">
            <div class="activity-meta"><strong><%= a.agent_name %></strong> &middot; <%= a.created_at %></div>
            <div class="activity-body <%= a.type !== 'note' ? 'muted' : '' %>"><%= a.body %></div>
          </li>
        <% }) %>
      </ul>

      <form action="/dashboard/tickets/<%= ticket.id %>/note" method="POST" class="stacked-form" enctype="multipart/form-data">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <% if (cannedResponses.length) { %>
          <label for="canned-select">Insert a canned response</label>
          <select id="canned-select" data-target="body">
            <option value="">Choose one&hellip;</option>
            <% cannedResponses.forEach(function(c) { %>
              <option value="<%= c.body.replace(/"/g, '&quot;') %>"><%= c.title %></option>
            <% }) %>
          </select>
        <% } %>

        <label for="body">Add a note</label>
        <textarea id="body" name="body" rows="3" maxlength="5000" placeholder="Internal note, visible to helpdesk staff only"></textarea>

        <label for="note-attachments">Attach a file</label>
        <input type="file" id="note-attachments" name="attachments" multiple accept=".png,.jpg,.jpeg,.gif,.webp,.pdf,.txt,.csv">
        <p class="field-hint"><%= uploadHint %></p>

        <button type="submit" class="button-primary">Add note</button>
      </form>
    </div>
  </div>

  <div class="ticket-side">
    <div class="card">
      <h2>Priority</h2>
      <form action="/dashboard/tickets/<%= ticket.id %>/priority" method="POST" class="stacked-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <select name="priority">
          <% priorities.forEach(function(p) { %>
            <option value="<%= p %>" <%= ticket.priority === p ? 'selected' : '' %>><%= p %></option>
          <% }) %>
        </select>
        <button type="submit" class="button-secondary">Update priority</button>
      </form>
    </div>

    <div class="card">
      <h2>Status</h2>
      <form action="/dashboard/tickets/<%= ticket.id %>/status" method="POST" class="stacked-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <select name="status">
          <% statuses.forEach(function(s) { %>
            <option value="<%= s %>" <%= ticket.status === s ? 'selected' : '' %>><%= s %></option>
          <% }) %>
        </select>
        <button type="submit" class="button-secondary">Update status</button>
      </form>
    </div>

    <div class="card">
      <h2>Assignment</h2>
      <form action="/dashboard/tickets/<%= ticket.id %>/assign" method="POST" class="stacked-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <select name="assigned_to">
          <option value="">Unassigned</option>
          <% agents.forEach(function(a) { %>
            <option value="<%= a.id %>" <%= ticket.assigned_to === a.id ? 'selected' : '' %>><%= a.name %></option>
          <% }) %>
        </select>
        <button type="submit" class="button-secondary">Update assignment</button>
      </form>
    </div>
  </div>
</div>

<p><a href="/dashboard">&larr; Back to all tickets</a></p>
<%- include('../partials/footer') %>
