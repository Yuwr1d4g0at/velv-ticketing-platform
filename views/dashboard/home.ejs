<%- include('../partials/header') %>
<div class="dashboard-head">
  <h1>Dashboard</h1>
  <div class="stat-row">
    <% statuses.forEach(function(s) { %>
      <div class="stat-tile">
        <span class="stat-count"><%= counts[s] || 0 %></span>
        <span class="stat-label"><%= s %></span>
      </div>
    <% }) %>
  </div>
</div>

<form action="/dashboard" method="GET" class="filter-bar">
  <input type="text" name="q" placeholder="Search subject, name, or email&hellip;" value="<%= filters.q %>">

  <select name="status">
    <option value="">All statuses</option>
    <% statuses.forEach(function(s) { %>
      <option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= s %></option>
    <% }) %>
  </select>

  <select name="priority">
    <option value="">All priorities</option>
    <% priorities.forEach(function(p) { %>
      <option value="<%= p %>" <%= filters.priority === p ? 'selected' : '' %>><%= p %></option>
    <% }) %>
  </select>

  <select name="category">
    <option value="">All categories</option>
    <% categories.forEach(function(c) { %>
      <option value="<%= c %>" <%= filters.category === c ? 'selected' : '' %>><%= c %></option>
    <% }) %>
  </select>

  <select name="assigned">
    <option value="">Anyone</option>
    <option value="me" <%= filters.assigned === 'me' ? 'selected' : '' %>>Assigned to me</option>
    <option value="unassigned" <%= filters.assigned === 'unassigned' ? 'selected' : '' %>>Unassigned</option>
  </select>

  <button type="submit" class="button-secondary">Filter</button>
  <a href="/dashboard" class="button-secondary button-ghost">Reset</a>
</form>

<div class="table-wrap">
  <table class="ticket-table">
    <thead>
      <tr>
        <th>#</th>
        <th>Subject</th>
        <th>Requester</th>
        <th>Category</th>
        <th>Priority</th>
        <th>Status</th>
        <th>Assigned</th>
        <th>Updated</th>
      </tr>
    </thead>
    <tbody>
      <% if (!tickets.length) { %>
        <tr><td colspan="8" class="empty-row">No tickets match these filters.</td></tr>
      <% } %>
      <% tickets.forEach(function(t) { %>
        <tr>
          <td><a href="/dashboard/tickets/<%= t.id %>">#<%= t.id %></a></td>
          <td><a href="/dashboard/tickets/<%= t.id %>"><%= t.subject %></a></td>
          <td><%= t.requester_name %></td>
          <td><%= t.category %></td>
          <td><span class="badge badge-priority-<%= t.priority.toLowerCase() %>"><%= t.priority %></span></td>
          <td><span class="badge badge-status-<%= t.status.replace(/\s+/g, '-').toLowerCase() %>"><%= t.status %></span></td>
          <td><%= t.assigned_name || 'Unassigned' %></td>
          <td><%= t.updated_at %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<%- include('../partials/footer') %>
