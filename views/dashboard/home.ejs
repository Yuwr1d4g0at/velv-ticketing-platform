<%- include('../partials/header') %>
<div class="dashboard-head">
  <div class="dashboard-head-title">
    <h1>Dashboard</h1>
    <a href="/dashboard/tickets/new" class="button-primary">+ New ticket</a>
  </div>
  <div class="stat-row">
    <% statuses.forEach(function(s) { %>
      <div class="stat-tile stat-tile-<%= s.replace(/\s+/g, '-').toLowerCase() %>">
        <span class="stat-count"><%= counts[s] || 0 %></span>
        <span class="stat-label"><%= s %></span>
      </div>
    <% }) %>
    <% if (satisfaction.count) { %>
      <div class="stat-tile stat-tile-satisfaction">
        <span class="stat-count"><span class="icon icon-star is-filled"></span> <%= satisfaction.avg_rating.toFixed(1) %></span>
        <span class="stat-label">Satisfaction &middot; <%= satisfaction.count %> rating<%= satisfaction.count === 1 ? '' : 's' %></span>
      </div>
    <% } %>
    <% if (resolutionTime.count) { %>
      <div class="stat-tile stat-tile-resolution">
        <span class="stat-count"><%= resolutionTime.avg_days.toFixed(1) %>d</span>
        <span class="stat-label">Avg. time to resolve &middot; <%= resolutionTime.count %> ticket<%= resolutionTime.count === 1 ? '' : 's' %></span>
      </div>
    <% } %>
    <% if (firstResponseTime.count) { %>
      <div class="stat-tile stat-tile-resolution">
        <span class="stat-count"><%= firstResponseTime.avg_days.toFixed(1) %>d</span>
        <span class="stat-label">Avg. time to first response &middot; <%= firstResponseTime.count %> ticket<%= firstResponseTime.count === 1 ? '' : 's' %></span>
      </div>
    <% } %>
    <% if (reopenRate !== null) { %>
      <div class="stat-tile stat-tile-resolution">
        <span class="stat-count"><%= reopenRate.toFixed(0) %>%</span>
        <span class="stat-label">Reopen rate &middot; <%= reopenedCount %> of <%= everResolvedCount %> ever-resolved</span>
      </div>
    <% } %>
  </div>
</div>

<form action="/dashboard" method="GET" class="filter-bar">
  <input type="text" name="q" placeholder="Search subject, name, or email&hellip;" value="<%= filters.q %>">

  <select name="status">
    <option value="">All statuses</option>
    <% statuses.forEach(function(s) { %>
      <option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= s %></option>
    <% }) %>
  </select>

  <select name="priority">
    <option value="">All priorities</option>
    <% priorities.forEach(function(p) { %>
      <option value="<%= p %>" <%= filters.priority === p ? 'selected' : '' %>><%= p %></option>
    <% }) %>
  </select>

  <select name="category">
    <option value="">All categories</option>
    <% categories.forEach(function(c) { %>
      <option value="<%= c %>" <%= filters.category === c ? 'selected' : '' %>><%= c %></option>
    <% }) %>
  </select>

  <select name="assigned">
    <option value="">Anyone</option>
    <option value="me" <%= filters.assigned === 'me' ? 'selected' : '' %>>Assigned to me</option>
    <option value="unassigned" <%= filters.assigned === 'unassigned' ? 'selected' : '' %>>Unassigned</option>
  </select>

  <% if (allTags.length) { %>
    <select name="tag">
      <option value="">All tags</option>
      <% allTags.forEach(function(t) { %>
        <option value="<%= t.name %>" <%= filters.tag === t.name ? 'selected' : '' %>><%= t.name %></option>
      <% }) %>
    </select>
  <% } %>

  <button type="submit" class="button-secondary">Filter</button>
  <a href="/dashboard" class="button-secondary button-ghost">Reset</a>
  <a href="/dashboard/export.csv?<%= exportQuery %>" class="button-secondary button-ghost">
    <span class="icon icon-download"></span> Export CSV
  </a>
</form>

<div class="tag-row saved-views-row">
  <% savedViews.forEach(function(v) { %>
    <span class="tag-chip">
      <a href="/dashboard?<%= v.query_string %>"><%= v.name %></a>
      <form action="/dashboard/views/<%= v.id %>/delete" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" aria-label="Delete saved view <%= v.name %>">&times;</button>
      </form>
    </span>
  <% }) %>
  <form action="/dashboard/views" method="POST" class="tag-add-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="query_string" value="<%= exportQuery %>">
    <input type="text" name="name" placeholder="Save current filters as&hellip;" maxlength="100">
    <button type="submit" class="button-secondary">Save view</button>
  </form>
</div>

<form action="/dashboard/bulk/status" method="POST" id="bulk-form">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <input type="hidden" name="redirect_to" value="/dashboard?<%= exportQuery %>&page=<%= page %>">

  <div class="bulk-action-bar">
    <span class="bulk-action-label"><span id="bulk-count">0</span> selected</span>
    <select name="status">
      <option value="">Set status&hellip;</option>
      <% statuses.forEach(function(s) { %><option value="<%= s %>"><%= s %></option><% }) %>
    </select>
    <button type="submit" formaction="/dashboard/bulk/status" class="button-secondary">Apply</button>

    <select name="assigned_to">
      <option value="">Unassigned</option>
      <% agents.forEach(function(a) { %><option value="<%= a.id %>"><%= a.name %></option><% }) %>
    </select>
    <button type="submit" formaction="/dashboard/bulk/assign" class="button-secondary">Apply</button>

    <input type="text" name="tag_name" placeholder="Tag name&hellip;" maxlength="30" list="bulk-tag-options">
    <datalist id="bulk-tag-options">
      <% allTags.forEach(function(t) { %><option value="<%= t.name %>"><% }) %>
    </datalist>
    <button type="submit" formaction="/dashboard/bulk/tag" name="tag_action" value="add" class="button-secondary">Add tag</button>
    <button type="submit" formaction="/dashboard/bulk/tag" name="tag_action" value="remove" class="button-secondary">Remove tag</button>
  </div>

  <div class="table-wrap">
    <table class="ticket-table">
      <thead>
        <tr>
          <th scope="col"><input type="checkbox" id="select-all" aria-label="Select all tickets"></th>
          <th scope="col">#</th>
          <th scope="col">Subject</th>
          <th scope="col">Requester</th>
          <th scope="col">Category</th>
          <th scope="col">Priority</th>
          <th scope="col">Status</th>
          <th scope="col">Assigned</th>
          <th scope="col">Updated</th>
        </tr>
      </thead>
      <tbody>
        <% if (!tickets.length) { %>
          <tr><td colspan="9" class="empty-row">No tickets match these filters.</td></tr>
        <% } %>
        <% tickets.forEach(function(t) { %>
          <tr>
            <td><input type="checkbox" name="ticket_ids" value="<%= t.id %>" class="row-select" aria-label="Select ticket #<%= t.id %>"></td>
            <td><a href="/dashboard/tickets/<%= t.id %>">#<%= t.id %></a></td>
            <td>
              <a href="/dashboard/tickets/<%= t.id %>"><%= t.subject %></a>
              <% if (t.is_aging) { %><span class="badge badge-aging">Aging</span><% } %>
            </td>
            <td><%= t.requester_name %></td>
            <td><%= t.category %><% if (t.subcategory) { %> <span class="muted">&rsaquo; <%= t.subcategory %></span><% } %></td>
            <td><span class="badge badge-priority-<%= t.priority.toLowerCase() %>"><%= t.priority %></span></td>
            <td><span class="badge badge-status-<%= t.status.replace(/\s+/g, '-').toLowerCase() %>"><%= t.status %></span></td>
            <td><%= t.assigned_name || 'Unassigned' %></td>
            <td><%= t.updated_at %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</form>

<% if (totalPages > 1) { %>
  <nav class="pagination">
    <% if (page > 1) { %>
      <a class="button-secondary" href="/dashboard?<%= exportQuery %>&page=<%= page - 1 %>">&larr; Previous</a>
    <% } else { %>
      <span class="button-secondary" aria-disabled="true">&larr; Previous</span>
    <% } %>
    <span class="pagination-status">Page <%= page %> of <%= totalPages %> &middot; <%= totalCount %> ticket<%= totalCount === 1 ? '' : 's' %></span>
    <% if (page < totalPages) { %>
      <a class="button-secondary" href="/dashboard?<%= exportQuery %>&page=<%= page + 1 %>">Next &rarr;</a>
    <% } else { %>
      <span class="button-secondary" aria-disabled="true">Next &rarr;</span>
    <% } %>
  </nav>
<% } %>

<div class="dashboard-reports">
  <div class="reports-head">
    <h2 class="dashboard-reports-title">Reports</h2>
    <form action="/dashboard" method="GET" class="report-range-form">
      <% Object.entries(filters).forEach(function([k, v]) { %>
        <% if (v) { %><input type="hidden" name="<%= k %>" value="<%= v %>"><% } %>
      <% }) %>
      <label for="report_range">Date range</label>
      <select id="report_range" name="report_range">
        <option value="7d" <%= reportRange.range === '7d' ? 'selected' : '' %>>Last 7 days</option>
        <option value="30d" <%= reportRange.range === '30d' ? 'selected' : '' %>>Last 30 days</option>
        <option value="90d" <%= reportRange.range === '90d' ? 'selected' : '' %>>Last 90 days</option>
        <option value="custom" <%= reportRange.range === 'custom' ? 'selected' : '' %>>Custom range&hellip;</option>
      </select>
      <% if (reportRange.range === 'custom') { %>
        <input type="date" name="report_from" value="<%= reportRange.from %>" required aria-label="From date">
        <input type="date" name="report_to" value="<%= reportRange.to %>" required aria-label="To date">
      <% } %>
      <button type="submit" class="button-secondary">Apply</button>
    </form>
  </div>

  <div class="report-row-3">
    <div class="card">
      <p class="chart-eyebrow"><%= reportRange.label %></p>
      <h2>Tickets created</h2>
      <% if (volume.every(function(v) { return v.count === 0; })) { %>
        <div class="chart-empty">
          <span class="icon icon-inbox"></span>
          <p>No tickets created in this window.</p>
        </div>
      <% } else { %>
        <div class="vbar-chart" role="img" aria-label="Bar chart of tickets created over the selected date range">
          <% volume.forEach(function(v) { %>
            <div class="vbar-col chart-tip" data-tip="<%= v.day %>: <%= v.count %> ticket<%= v.count === 1 ? '' : 's' %>">
              <div class="vbar-fill <%= v.barClass %>"></div>
            </div>
          <% }) %>
        </div>
        <div class="vbar-axis">
          <span><%= volume[0].day %></span>
          <span><%= volume[volume.length - 1].day %></span>
        </div>
      <% } %>
    </div>

    <div class="card">
      <p class="chart-eyebrow"><%= reportRange.unit === 'day' ? 'By day' : 'By month' %></p>
      <h2>Satisfaction trend</h2>
      <% if (!csatTrend.length) { %>
        <div class="chart-empty">
          <span class="icon icon-star"></span>
          <p>No ratings yet.</p>
        </div>
      <% } else { %>
        <div class="vbar-chart" role="img" aria-label="Bar chart of average satisfaction rating over the selected date range">
          <% csatTrend.forEach(function(m) { %>
            <div class="vbar-col chart-tip" data-tip="<%= m.month %>: <%= m.avg_rating.toFixed(1) %>/5 (<%= m.count %> rating<%= m.count === 1 ? '' : 's' %>)">
              <div class="vbar-fill <%= m.barClass %>"></div>
            </div>
          <% }) %>
        </div>
        <div class="vbar-axis">
          <span><%= csatTrend[0].month %></span>
          <span><%= csatTrend[csatTrend.length - 1].month %></span>
        </div>
      <% } %>
    </div>

    <div class="card">
      <p class="chart-eyebrow"><%= reportRange.unit === 'day' ? 'By day' : 'By month' %></p>
      <h2>SLA compliance</h2>
      <% if (!slaCompliance.length) { %>
        <div class="chart-empty">
          <span class="icon icon-inbox"></span>
          <p>No tickets resolved in this window.</p>
        </div>
      <% } else { %>
        <div class="vbar-chart" role="img" aria-label="Bar chart of SLA compliance rate over the selected date range">
          <% slaCompliance.forEach(function(s) { %>
            <div class="vbar-col chart-tip" data-tip="<%= s.month %>: <%= s.pct.toFixed(0) %>% met (<%= s.met %>/<%= s.total %> resolved)">
              <div class="vbar-fill <%= s.barClass %>"></div>
            </div>
          <% }) %>
        </div>
        <div class="vbar-axis">
          <span><%= slaCompliance[0].month %></span>
          <span><%= slaCompliance[slaCompliance.length - 1].month %></span>
        </div>
      <% } %>
    </div>
  </div>

  <div class="report-bento">
    <div class="card bento-category">
      <h2>By category</h2>
      <% if (!byCategory.length) { %>
        <div class="chart-empty">
          <span class="icon icon-inbox"></span>
          <p>No tickets yet.</p>
        </div>
      <% } else { %>
        <div class="hbar-chart">
          <% byCategory.forEach(function(r) { %>
            <div class="hbar-row">
              <span class="hbar-label"><%= r.label %></span>
              <span class="hbar-track"><span class="hbar-fill <%= r.barClass %>"></span></span>
              <span class="hbar-value"><%= r.count %></span>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>

    <div class="card bento-status">
      <h2>By status</h2>
      <% if (!byStatus.length) { %>
        <div class="chart-empty">
          <span class="icon icon-inbox"></span>
          <p>No tickets yet.</p>
        </div>
      <% } else { %>
        <div class="hbar-chart">
          <% byStatus.forEach(function(r) { %>
            <div class="hbar-row">
              <span class="hbar-label"><%= r.label %></span>
              <span class="hbar-track"><span class="hbar-fill <%= r.barClass %>"></span></span>
              <span class="hbar-value"><%= r.count %></span>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>

    <div class="card bento-workload">
      <h2>Current workload</h2>
      <p class="muted">Open + In Progress tickets, by agent.</p>
      <% if (!byAgent.length) { %>
        <div class="chart-empty">
          <span class="icon icon-inbox"></span>
          <p>Nothing open right now.</p>
        </div>
      <% } else { %>
        <div class="hbar-chart">
          <% byAgent.forEach(function(r) { %>
            <div class="hbar-row">
              <span class="hbar-label"><%= r.label %></span>
              <span class="hbar-track"><span class="hbar-fill <%= r.barClass %>"></span></span>
              <span class="hbar-value"><%= r.count %></span>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>
  </div>

  <div class="card">
    <h2>Agent performance</h2>
    <% if (!agentPerformance.length) { %>
      <p class="muted">No active agents.</p>
    <% } else { %>
      <div class="table-wrap">
        <table class="ticket-table">
          <thead>
            <tr>
              <th scope="col">Agent</th>
              <th scope="col">Resolved</th>
              <th scope="col">Avg. resolution</th>
              <th scope="col">Avg. CSAT</th>
            </tr>
          </thead>
          <tbody>
            <% agentPerformance.forEach(function(a) { %>
              <tr>
                <td><%= a.name %></td>
                <td><%= a.resolved_count %></td>
                <td><% if (a.avg_resolution_days != null) { %><%= a.avg_resolution_days.toFixed(1) %>d<% } else { %>&mdash;<% } %></td>
                <td><% if (a.avg_csat != null) { %><%= a.avg_csat.toFixed(1) %>/5<% } else { %>&mdash;<% } %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>
<%- include('../partials/footer') %>
