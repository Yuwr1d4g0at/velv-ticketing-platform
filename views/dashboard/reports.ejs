<%- include('../partials/header') %>
<h1>Reports</h1>
<p class="muted">A quick read on volume and load - not a substitute for the filterable ticket list, just the trends it doesn't show at a glance.</p>

<div class="stat-row">
  <% if (firstResponseTime.count) { %>
    <div class="stat-tile stat-tile-resolution">
      <span class="stat-count"><%= firstResponseTime.avg_days.toFixed(1) %>d</span>
      <span class="stat-label">Avg. time to first response &middot; <%= firstResponseTime.count %> ticket<%= firstResponseTime.count === 1 ? '' : 's' %></span>
    </div>
  <% } %>
  <% if (resolutionTime.count) { %>
    <div class="stat-tile stat-tile-resolution">
      <span class="stat-count"><%= resolutionTime.avg_days.toFixed(1) %>d</span>
      <span class="stat-label">Avg. time to resolve &middot; <%= resolutionTime.count %> ticket<%= resolutionTime.count === 1 ? '' : 's' %></span>
    </div>
  <% } %>
  <% if (reopenRate !== null) { %>
    <div class="stat-tile stat-tile-resolution">
      <span class="stat-count"><%= reopenRate.toFixed(0) %>%</span>
      <span class="stat-label">Reopen rate &middot; <%= reopenedCount %> of <%= everResolvedCount %> ever-resolved ticket<%= everResolvedCount === 1 ? '' : 's' %></span>
    </div>
  <% } %>
</div>

<div class="card card-wide">
  <h2>Tickets created, last 30 days</h2>
  <% if (volume.every(function(v) { return v.count === 0; })) { %>
    <p class="muted">No tickets created in this window.</p>
  <% } else { %>
    <div class="vbar-chart" role="img" aria-label="Bar chart of tickets created per day over the last 30 days">
      <% volume.forEach(function(v) { %>
        <div class="vbar-col" title="<%= v.day %>: <%= v.count %>">
          <div class="vbar-fill <%= v.barClass %>"></div>
        </div>
      <% }) %>
    </div>
    <div class="vbar-axis">
      <span><%= volume[0].day %></span>
      <span><%= volume[volume.length - 1].day %></span>
    </div>
  <% } %>
</div>

<div class="card card-wide">
  <h2>Satisfaction trend</h2>
  <% if (!csatTrend.length) { %>
    <p class="muted">No ratings yet.</p>
  <% } else { %>
    <div class="vbar-chart" role="img" aria-label="Bar chart of average satisfaction rating by month">
      <% csatTrend.forEach(function(m) { %>
        <div class="vbar-col" title="<%= m.month %>: <%= m.avg_rating.toFixed(1) %>/5 (<%= m.count %> rating<%= m.count === 1 ? '' : 's' %>)">
          <div class="vbar-fill <%= m.barClass %>"></div>
        </div>
      <% }) %>
    </div>
    <div class="vbar-axis">
      <span><%= csatTrend[0].month %></span>
      <span><%= csatTrend[csatTrend.length - 1].month %></span>
    </div>
  <% } %>
</div>

<div class="card card-wide">
  <h2>Agent performance</h2>
  <% if (!agentPerformance.length) { %>
    <p class="muted">No active agents.</p>
  <% } else { %>
    <div class="table-wrap">
      <table class="ticket-table">
        <thead>
          <tr>
            <th scope="col">Agent</th>
            <th scope="col">Resolved</th>
            <th scope="col">Avg. resolution time</th>
            <th scope="col">Avg. CSAT</th>
          </tr>
        </thead>
        <tbody>
          <% agentPerformance.forEach(function(a) { %>
            <tr>
              <td><%= a.name %></td>
              <td><%= a.resolved_count %></td>
              <td><% if (a.avg_resolution_days != null) { %><%= a.avg_resolution_days.toFixed(1) %>d<% } else { %>&mdash;<% } %></td>
              <td><% if (a.avg_csat != null) { %><%= a.avg_csat.toFixed(1) %>/5<% } else { %>&mdash;<% } %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<div class="report-grid">
  <div class="card">
    <h2>By category</h2>
    <% if (!byCategory.length) { %>
      <p class="muted">No tickets yet.</p>
    <% } else { %>
      <div class="hbar-chart">
        <% byCategory.forEach(function(r) { %>
          <div class="hbar-row">
            <span class="hbar-label"><%= r.label %></span>
            <span class="hbar-track"><span class="hbar-fill <%= r.barClass %>"></span></span>
            <span class="hbar-value"><%= r.count %></span>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>

  <div class="card">
    <h2>By status</h2>
    <% if (!byStatus.length) { %>
      <p class="muted">No tickets yet.</p>
    <% } else { %>
      <div class="hbar-chart">
        <% byStatus.forEach(function(r) { %>
          <div class="hbar-row">
            <span class="hbar-label"><%= r.label %></span>
            <span class="hbar-track"><span class="hbar-fill <%= r.barClass %>"></span></span>
            <span class="hbar-value"><%= r.count %></span>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>

  <div class="card">
    <h2>Current workload by agent</h2>
    <p class="muted">Open + In Progress tickets.</p>
    <% if (!byAgent.length) { %>
      <p class="muted">Nothing open right now.</p>
    <% } else { %>
      <div class="hbar-chart">
        <% byAgent.forEach(function(r) { %>
          <div class="hbar-row">
            <span class="hbar-label"><%= r.label %></span>
            <span class="hbar-track"><span class="hbar-fill <%= r.barClass %>"></span></span>
            <span class="hbar-value"><%= r.count %></span>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</div>
<%- include('../partials/footer') %>
