<%- include('../partials/header') %>
<div class="dashboard-head-title">
  <h1>Knowledge base</h1>
  <a href="/dashboard/kb/new" class="button-primary">+ New article</a>
</div>
<p class="muted">Public, searchable help articles at <a href="/kb" target="_blank" rel="noopener">/kb</a> - the biggest lever for cutting ticket volume. Link one into a ticket reply from the note form.</p>

<div class="table-wrap">
  <table class="ticket-table">
    <thead>
      <tr>
        <th scope="col">Title</th>
        <th scope="col">Category</th>
        <th scope="col">Status</th>
        <th scope="col">Updated</th>
      </tr>
    </thead>
    <tbody>
      <% if (!articles.length) { %>
        <tr><td colspan="4" class="empty-row">No articles yet.</td></tr>
      <% } %>
      <% articles.forEach(function(a) { %>
        <tr>
          <td><a href="/dashboard/kb/<%= a.id %>/edit"><%= a.title %></a></td>
          <td><% if (a.category) { %><%= a.category %><% } else { %>&mdash;<% } %></td>
          <td><span class="badge <%= a.published ? 'badge-status-open' : 'badge-status-closed' %>"><%= a.published ? 'Published' : 'Draft' %></span></td>
          <td><%= a.updated_at %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<%- include('../partials/footer') %>
